# ------------------------------------------------------------------
# Thiel Dienstleistungen – Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und fülle die Werte aus.
# ------------------------------------------------------------------

# Supabase: Projekt-URL & anonymer Key
# (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service-Role-Key – NUR serverseitig (API-Routen) verwenden, niemals im Frontend!
# (Supabase Dashboard -> Project Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# OpenAI API-Key für den Foto-Import (Vision OCR, GPT-4o-mini)
# (https://platform.openai.com/api-keys)
GEMINI_API_KEY="your-gemini-api-key"

# Routen-Optimierung (optional):
# Ohne Key läuft die Berechnung im Demo-Modus (Luftlinien-Distanzen).
# OpenRouteService: https://openrouteservice.org (kostenlose API-Key-Option)
ORS_API_KEY="your-openrouteservice-api-key"
# Alternativ Google Maps (Geocoding + Distance Matrix):
GOOGLE_MAPS_API_KEY=
# Start-/Endpunkt der Rundtour (Lager). Falls leer: Platzhalter-Adresse.
WAREHOUSE_ADDRESS="Sartoriusstraße 14, 97072 Würzburg-Altstadt"
