# ------------------------------------------------------------------
# Thiel Dienstleistungen – Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und fülle die Werte aus.
# ------------------------------------------------------------------

# Supabase: Projekt-URL
# (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Anonymer Key – PFLICHT: wird von Login/Session (Middleware, SSR) verwendet.
# (Supabase Dashboard -> Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-Role-Key – NUR serverseitig (API-Routen) verwenden, niemals im Frontend!
# (Supabase Dashboard -> Project Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API-Key für den Foto-Import (Vision OCR, gemini-flash-lite-latest)
# (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Routen-Optimierung (optional):
# Ohne Key läuft die Berechnung im Demo-Modus (Luftlinien-Distanzen).
# OpenRouteService: https://openrouteservice.org (kostenlose API-Key-Option)
ORS_API_KEY=
# Alternativ Google Maps (Geocoding + Distance Matrix):
GOOGLE_MAPS_API_KEY=
# Live-Verkehr (optional): TomTom Matrix Routing v2 API-Key.
# Wird gesetzt, fließen aktuelle Stauzeiten als Custom-Matrix in die VROOM-Optimierung ein.
# ACHTUNG: Variablenname exakt TOMTOM_API_KEY (Groß-/Kleinschreibung zählt!).
# Key: https://developer.tomtom.com -> Dashboard -> My Apps -> Primary Key
TOMTOM_API_KEY=
# Optional: Maximale Matrix-Zellen (origins x destinations) für TomTom.
# Free-Tier ca. 100, Sync-Hardcap 2500. Größere Touren fallen sonst auf ORS zurück.
TOMTOM_MAX_CELLS=
# Start-/Endpunkt der Rundtour (Lager). Falls leer: Sartoriusstraße 14, 97072 Würzburg.
WAREHOUSE_ADDRESS=

# WebAuthn/Passkeys (optional):
# Domain für die Passkey-Registrierung (ohne Protokoll, z. B. thiel-app.vercel.app).
# Falls leer, wird automatisch der aktuelle Host verwendet.
WEBAUTHN_RP_ID=
# Anzeigename des Relying Party (optional, Standard: "Thiel Dienstleistungen")
WEBAUTHN_RP_NAME=
