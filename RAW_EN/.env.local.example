# ------------------------------------------------------------------
# Company app – environment variables
# Copy this file to `.env.local` and fill in the values.
# NEXT_PUBLIC_* values are compiled in at build time (also in the browser).
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# 1) Company & warehouse
# ------------------------------------------------------------------
# Display name of the company (header, login, page title, passkey name)
NEXT_PUBLIC_COMPANY_NAME="Example Company"
# Short form for filenames (e.g. payroll export); empty = derived from the name
NEXT_PUBLIC_COMPANY_SLUG=
# Internal login domain: username "max" becomes max@<domain>
NEXT_PUBLIC_USER_EMAIL_DOMAIN="company.local"

# Warehouse = start/end of the round trip
NEXT_PUBLIC_WAREHOUSE_NAME=
WAREHOUSE_ADDRESS="1 Example Street, 12345 Example Town"
# Only needed if the warehouse address is also used in the browser (tour navigation)
NEXT_PUBLIC_WAREHOUSE_ADDRESS=

# ------------------------------------------------------------------
# 2) Service area (optional)
# Without these values the app works location-independent: addresses without a
# city stay unchanged and the geocoding search is not restricted.
# ------------------------------------------------------------------
# City added to addresses without one
NEXT_PUBLIC_SERVICE_CITY=
# Map centre used to prioritise search results
NEXT_PUBLIC_SERVICE_CITY_LAT=
NEXT_PUBLIC_SERVICE_CITY_LON=
# Search boundary "minLon,minLat,maxLon,maxLat"
NEXT_PUBLIC_SERVICE_AREA_BOUNDARY=

# ------------------------------------------------------------------
# 3) Supabase: project URL & keys
# (Supabase dashboard -> Project Settings -> API)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key – server-side only (API routes), never in the frontend!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# ------------------------------------------------------------------
# 4) External APIs (optional – fallbacks work without keys)
# ------------------------------------------------------------------
# Photo import (vision OCR)
GEMINI_API_KEY="your-gemini-api-key"
# Route optimisation / geocoding (OpenRouteService)
ORS_API_KEY="your-openrouteservice-api-key"
# Alternative distance matrix: Google Maps, TomTom (live traffic) or Stadia
GOOGLE_MAPS_API_KEY=
TOMTOM_API_KEY=
TOMTOM_MAX_CELLS=
STADIA_API_KEY=

# ------------------------------------------------------------------
# 5) Passkeys (WebAuthn) & push
# ------------------------------------------------------------------
# Default: the app's host or NEXT_PUBLIC_COMPANY_NAME
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@example.com"
