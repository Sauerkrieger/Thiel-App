# ------------------------------------------------------------------
# Firmen-App – Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und fülle die Werte aus.
# NEXT_PUBLIC_*-Werte werden beim Build fest eingetragen (auch im Browser).
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# 1) Firma & Lager
# ------------------------------------------------------------------
# Anzeigename der Firma (Header, Login, Seitentitel, Passkey-Name)
NEXT_PUBLIC_COMPANY_NAME="Musterfirma"
# Kurzform für Dateinamen (z. B. Lohnexport); leer = aus dem Firmennamen abgeleitet
NEXT_PUBLIC_COMPANY_SLUG=
# Interne Login-Domain: Benutzername "max" wird zu max@<domain>
NEXT_PUBLIC_USER_EMAIL_DOMAIN="company.local"

# Lager = Start/Ziel der Rundtour
NEXT_PUBLIC_WAREHOUSE_NAME=
WAREHOUSE_ADDRESS="Musterstraße 1, 12345 Musterstadt"
# Nur nötig, wenn die Lageradresse auch im Browser gebraucht wird (Tour-Navigation)
NEXT_PUBLIC_WAREHOUSE_ADDRESS=

# ------------------------------------------------------------------
# 2) Einsatzgebiet (optional)
# Ohne diese Werte arbeitet die App ortsunabhängig: Adressen ohne
# Ortsangabe bleiben unverändert, die Geocoding-Suche wird nicht begrenzt.
# ------------------------------------------------------------------
# Stadt, die bei Adressen ohne Ortsangabe ergänzt wird
NEXT_PUBLIC_SERVICE_CITY=
# Kartenmittelpunkt für die Treffer-Priorisierung
NEXT_PUBLIC_SERVICE_CITY_LAT=
NEXT_PUBLIC_SERVICE_CITY_LON=
# Suchgrenze "minLon,minLat,maxLon,maxLat"
NEXT_PUBLIC_SERVICE_AREA_BOUNDARY=

# ------------------------------------------------------------------
# 3) Supabase: Projekt-URL & Keys
# (Supabase Dashboard -> Project Settings -> API)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service-Role-Key – NUR serverseitig (API-Routen) verwenden, niemals im Frontend!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------
# 4) Externe APIs (optional – ohne Keys laufen die Fallbacks)
# ------------------------------------------------------------------
# Foto-Import (Vision OCR)
GEMINI_API_KEY="your-gemini-api-key"
# Routen-Optimierung / Geocoding (OpenRouteService)
ORS_API_KEY="your-openrouteservice-api-key"
# Alternative Distanz-Matrix: Google Maps, TomTom (Live-Verkehr) oder Stadia
GOOGLE_MAPS_API_KEY=
TOMTOM_API_KEY=
TOMTOM_MAX_CELLS=
STADIA_API_KEY=

# ------------------------------------------------------------------
# 5) Passkeys (WebAuthn) & Push
# ------------------------------------------------------------------
# Default: Host der App bzw. NEXT_PUBLIC_COMPANY_NAME
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@example.com"
